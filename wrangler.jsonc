{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hitham",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": true }
}
